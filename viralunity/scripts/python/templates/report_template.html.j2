<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ViralUnity consensus report</title>
<script>{{ plotly_js|safe }}</script>
<style>
:root {
  --page-bg: #f9f9f7;
  --card-bg: #fcfcfb;
  --text-primary: #0b0b0b;
  --text-secondary: #52514e;
  --text-muted: #898781;
  --border: rgba(11,11,11,0.10);
  --accent: #2a78d6;
  --hover: rgba(42,120,214,0.08);
}
:root[data-theme="dark"] {
  --page-bg: #0d0d0d;
  --card-bg: #1a1a19;
  --text-primary: #ffffff;
  --text-secondary: #c3c2b7;
  --text-muted: #898781;
  --border: rgba(255,255,255,0.10);
  --accent: #3987e5;
  --hover: rgba(57,135,229,0.12);
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  background: var(--page-bg);
  color: var(--text-primary);
  line-height: 1.5;
}
header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20px 28px; border-bottom: 1px solid var(--border);
}
header h1 { font-size: 1.25rem; margin: 0; font-weight: 600; }
main { max-width: 1000px; margin: 0 auto; padding: 24px 20px 64px; }
.section-title {
  font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--text-muted); margin: 28px 4px 12px;
}
.card {
  background: var(--card-bg); border: 1px solid var(--border);
  border-radius: 14px; padding: 20px 22px; margin-bottom: 18px;
  overflow-x: auto;
}
.card h2 { font-size: 1rem; margin: 0 0 14px; font-weight: 600; }
.theme-toggle {
  background: var(--card-bg); border: 1px solid var(--border);
  color: var(--text-secondary); border-radius: 8px; padding: 7px 12px;
  cursor: pointer; font-size: 0.85rem;
}
.theme-toggle:hover { background: var(--hover); }
select {
  background: var(--card-bg); border: 1px solid var(--border);
  color: var(--text-primary); border-radius: 8px; padding: 7px 10px;
  font-size: 0.9rem; margin: 0 8px 14px 0;
}
label.control { font-size: 0.85rem; color: var(--text-secondary); margin-right: 6px; }
table.stats-table { border-collapse: collapse; width: 100%; font-size: 0.85rem; }
table.stats-table th, table.stats-table td {
  padding: 7px 14px; text-align: center; white-space: nowrap;
  border-bottom: 1px solid var(--border); font-variant-numeric: tabular-nums;
}
table.stats-table th {
  cursor: pointer; user-select: none; color: var(--text-secondary);
  font-weight: 600; position: sticky; top: 0; background: var(--card-bg);
}
table.stats-table th:hover { color: var(--text-primary); }
table.stats-table tbody tr:hover { background: var(--hover); }
.sort-arrow { font-size: 0.7em; color: var(--text-muted); margin-left: 4px; }
.plot-holder { min-height: 60px; }
.chart-note { font-size: 0.8rem; color: var(--text-muted); margin: 8px 4px 0; }
.run-meta { font-size: 0.85rem; color: var(--text-secondary); margin: 0 4px 16px; }
/* Charts fill the card (responsive) but never stretch past their design width. */
.card .plotly-graph-div, .card .js-plotly-plot { width: 100%; max-width: 900px; }
/* Separate the per-sample stats table from the coverage plot(s) below it; the
   table's own last-row hairline reads cleanly, so spacing alone suffices. */
#sample-coverage, #segment-coverage { margin-top: 28px; }
/* Stacked coverage plots (one per segment, or one per sample in the by-segment
   view) get breathing room and a hairline divider so each reads as its own panel. */
#sample-coverage > div + div, #segment-coverage > div + div {
  margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--border);
}
/* Linear/Log10 toggle */
.scale-toggle { display: inline-flex; border: 1px solid var(--border); border-radius: 7px; overflow: hidden; vertical-align: middle; margin: 0 0 14px; }
.scale-toggle button { border: none; background: var(--card-bg); color: var(--text-secondary); font: inherit; font-size: 0.8rem; padding: 6px 12px; cursor: pointer; }
.scale-toggle button + button { border-left: 1px solid var(--border); }
.scale-toggle button.active { background: var(--accent); color: #fff; }
.scale-toggle button:hover:not(.active) { background: var(--hover); }
.scale-toggle button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
.chart-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; margin-bottom: 6px; }
.chart-controls .scale-toggle { margin: 0; }
table.stats-table th[role="button"]:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
/* Progressive disclosure: per-sample / per-segment detail behind a collapsed accordion. */
.sample-details > summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.sample-details > summary::-webkit-details-marker { display: none; }
.sample-details > summary::before { content: '\25B8'; color: var(--text-muted); font-size: 0.85em; transition: transform 0.15s ease; }
.sample-details[open] > summary::before { transform: rotate(90deg); }
.sample-details > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
.sample-summary-title { font-size: 1rem; font-weight: 600; }
.sample-summary-hint { font-size: 0.8rem; color: var(--text-muted); font-weight: 400; }
.sample-details-body { margin-top: 18px; }
@media (prefers-reduced-motion: reduce) { .sample-details > summary::before { transition: none; } }
/* KPI summary tiles (big BI-style numbers). Values wear text tokens, not a
   series colour; proportional figures (not tabular) so a big number isn't loose. */
.kpi-controls { margin: 4px 0 12px; }
.kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 8px; }
.kpi-tile { background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; }
.kpi-value { font-size: 2rem; font-weight: 600; line-height: 1.1; color: var(--text-primary); font-variant-numeric: proportional-nums; }
.kpi-label { font-size: 0.85rem; color: var(--text-secondary); margin-top: 6px; }
.kpi-sub { font-size: 0.78rem; color: var(--text-muted); margin-top: 2px; }
</style>
</head>
<body data-palette="{{ palette_light|join(',') }}">
<header>
  <h1>ViralUnity consensus report{% if segmented %} <span style="color:var(--text-muted);font-weight:400">· segmented</span>{% endif %}</h1>
  <button class="theme-toggle" onclick="toggleTheme()" id="theme-btn">Dark mode</button>
</header>
<main>

  <p class="section-title">Summary</p>
  {% if segmented %}
  <div class="chart-controls kpi-controls">
    <div class="scale-toggle" role="group" aria-label="KPI scope" id="kpi-scope">
      <button type="button" class="active" data-scope="global">Global</button>
      <button type="button" data-scope="segment">Per segment</button>
    </div>
    <label class="control" for="kpiSegmentSelect" id="kpiSegmentLabel" style="display:none">Segment</label>
    <select id="kpiSegmentSelect" style="display:none">
      {% for s in segments %}<option value="{{ s }}">{{ s }}</option>{% endfor %}
    </select>
  </div>
  {% endif %}
  <div class="kpi-grid" id="kpi-grid">
    <div class="kpi-tile"><div class="kpi-value" data-kpi="samples">{{ kpi_global.samples }}</div><div class="kpi-label">Samples analyzed</div></div>
    <div class="kpi-tile"><div class="kpi-value" data-kpi="ge90">{{ kpi_global.ge90 }}</div><div class="kpi-label">&ge;90% coverage</div><div class="kpi-sub" data-kpi="ge90_sub">of {{ kpi_global.samples }} samples</div></div>
    <div class="kpi-tile"><div class="kpi-value" data-kpi="ge70">{{ kpi_global.ge70 }}</div><div class="kpi-label">&ge;70% coverage</div><div class="kpi-sub" data-kpi="ge70_sub">of {{ kpi_global.samples }} samples</div></div>
    <div class="kpi-tile"><div class="kpi-value" data-kpi="median_depth">{{ kpi_global.median_depth }}</div><div class="kpi-label">Median mean depth</div></div>
  </div>

  <p class="section-title">Overview</p>

  {% if metadata %}
  <p class="run-meta">
    {{ metadata.platform|capitalize }} &middot; {{ metadata.library_layout }}-end
    {%- if metadata.primer_scheme %} &middot; primers: {{ metadata.primer_scheme }}{% endif %}
    {%- if not metadata.qc_performed %} &middot; no read-QC step (Nanopore){% endif %}
  </p>
  {% endif %}

  <div class="card">
    <h2>Assembly statistics</h2>
    {{ stats_table_html|safe }}
  </div>

  <div class="card">
    <h2>Sequencing throughput</h2>
    {{ reads_fig_html|safe }}
  </div>

  <div class="card">
    <h2>Aggregated coverage</h2>
    {% if segmented %}
    <div>
      <label class="control" for="aggSegmentSelect">Segment</label>
      <select id="aggSegmentSelect" onchange="showPanel('agg-panel', this.value)">
        {% for panel in aggregated_panels %}
        <option value="{{ panel.segment }}">{{ panel.segment }}</option>
        {% endfor %}
      </select>
    </div>
    {% endif %}
    {% for panel in aggregated_panels %}
    <div class="agg-panel" data-key="{{ panel.segment }}" style="display: {{ 'block' if loop.first else 'none' }};">
      {{ panel.html|safe }}
    </div>
    {% endfor %}
  </div>

  <p class="section-title">Per-sample detail</p>

  <div class="card">
    <h2>Coverage by sample</h2>
    <div>
      <label class="control" for="sampleSelect">Sample</label>
      <select id="sampleSelect" onchange="showSample(this.value)">
        {% for s in samples %}
        <option value="{{ s }}">{{ s }}</option>
        {% endfor %}
      </select>
    </div>
    <div id="sample-stats"></div>
    <div id="sample-coverage" class="plot-holder"></div>
  </div>

</main>

<script id="coverageData" type="application/json">{{ coverage_json|safe }}</script>
<script id="statsData" type="application/json">{{ stats_by_sample|safe }}</script>
<script id="kpiData" type="application/json">{{ kpi_json|safe }}</script>
<script>
const COVERAGE = JSON.parse(document.getElementById('coverageData').textContent);
const STATS = JSON.parse(document.getElementById('statsData').textContent);
const KPI = JSON.parse(document.getElementById('kpiData').textContent);
const FIG_WIDTH = 900, FIG_HEIGHT = 420;

/* ---- theme ---- */
function isDark() { return document.documentElement.getAttribute('data-theme') === 'dark'; }
function toggleTheme() {
  const dark = !isDark();
  document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
  document.getElementById('theme-btn').textContent = dark ? 'Light mode' : 'Dark mode';
  themeCharts();
}
function themeCharts() {
  // Gridlines use a semi-transparent gray that reads on both themes, so only
  // the font colour needs to flip. Applying font.color globally also covers
  // multi-axis subplots (the reads figure) that per-axis keys would miss.
  const dark = isDark();
  const upd = {
    'font.color': dark ? '#c3c2b7' : '#52514e',
    'paper_bgcolor': 'rgba(0,0,0,0)',
    'plot_bgcolor': 'rgba(0,0,0,0)',
  };
  document.querySelectorAll('.js-plotly-plot').forEach(function (gd) {
    try { Plotly.relayout(gd, upd); } catch (e) { /* not yet drawn */ }
  });
}

/* ---- generic display:none panel toggle (aggregated segment switch) ---- */
function showPanel(cls, key) {
  document.querySelectorAll('.' + cls).forEach(function (p) {
    p.style.display = (p.getAttribute('data-key') === key) ? 'block' : 'none';
  });
  themeCharts();
}

/* ---- client-side table sort ---- */
function sortTable(th) {
  const table = th.closest('table');
  const idx = parseInt(th.getAttribute('data-col'), 10);
  const asc = th.getAttribute('data-asc') !== 'true';
  const rows = Array.from(table.tBodies[0].rows);
  rows.sort(function (a, b) {
    const av = a.cells[idx].getAttribute('data-sort');
    const bv = b.cells[idx].getAttribute('data-sort');
    const an = parseFloat(av), bn = parseFloat(bv);
    let cmp;
    if (!isNaN(an) && !isNaN(bn)) cmp = an - bn;
    else cmp = String(av).localeCompare(String(bv));
    return asc ? cmp : -cmp;
  });
  rows.forEach(function (r) { table.tBodies[0].appendChild(r); });
  table.querySelectorAll('th').forEach(function (h) {
    h.setAttribute('data-asc', 'false');
    if (h.hasAttribute('aria-sort')) h.setAttribute('aria-sort', 'none');
    const arr = h.querySelector('.sort-arrow'); if (arr) arr.textContent = '';
  });
  th.setAttribute('data-asc', asc ? 'true' : 'false');
  if (th.hasAttribute('aria-sort')) th.setAttribute('aria-sort', asc ? 'ascending' : 'descending');
  const arrow = th.querySelector('.sort-arrow'); if (arrow) arrow.textContent = asc ? '▲' : '▼';
}

/* ---- sortable-header keyboard access (attrs are emitted server-side) ---- */
function enhanceSortHeaders() {
  document.querySelectorAll('table.stats-table th[onclick]').forEach(function (th) {
    th.addEventListener('keydown', function (ev) {
      if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); th.click(); }
    });
  });
}

/* ---- Linear/Log10 scale toggle control ---- */
function themeFont() {
  return {family: 'system-ui, -apple-system, "Segoe UI", sans-serif', size: 13,
          color: isDark() ? '#c3c2b7' : '#52514e'};
}
function scaleToggleEl(initial, onChange) {
  const wrap = document.createElement('div');
  wrap.className = 'scale-toggle';
  wrap.setAttribute('role', 'group');
  wrap.setAttribute('aria-label', 'Y-axis scale');
  ['linear', 'log'].forEach(function (s) {
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = s === 'linear' ? 'Linear' : 'Log10';
    b.setAttribute('data-scale', s);
    if (s === initial) b.className = 'active';
    b.addEventListener('click', function () {
      wrap.querySelectorAll('button').forEach(function (x) { x.classList.remove('active'); });
      b.classList.add('active');
      onChange(s);
    });
    wrap.appendChild(b);
  });
  return wrap;
}

/* ---- depth-axis layouts (shared by the coverage line charts) ----
   Depth axes are linear by default; the toggle switches to Log10 by REBUILDING
   the figure (Plotly.react/newPlot), never a relayout that flips yaxis.type —
   that path hits a Plotly slow path (~6s freeze) on the ~2000-point lines. The
   Log10 range comes from Python (entry.logRange), computed once, not re-derived
   here. The y-caption is just "Depth" in both modes (the toggle states the
   scale); log ticks are pinned to powers of ten (dtick 1). */
function depthYAxis(scale, logRange) {
  const common = {title: {text: 'Depth'}, gridcolor: 'rgba(137,135,129,0.25)', zeroline: false};
  if (scale === 'log') {
    return Object.assign(common, {type: 'log', range: logRange, dtick: 1});
  }
  return Object.assign(common, {type: 'linear', rangemode: 'tozero'});
}
function depthGuides() {
  return {
    shapes: [
      {type: 'line', xref: 'x domain', x0: 0, x1: 1, y0: 20, y1: 20, line: {color: '#898781', width: 1, dash: 'dot'}},
      {type: 'line', xref: 'x domain', x0: 0, x1: 1, y0: 100, y1: 100, line: {color: '#898781', width: 1, dash: 'dot'}}
    ],
    annotations: [
      {xref: 'paper', x: 1, y: 20, yref: 'y', text: '20x', showarrow: false, xanchor: 'right', font: {color: '#898781', size: 11}},
      {xref: 'paper', x: 1, y: 100, yref: 'y', text: '100x', showarrow: false, xanchor: 'right', font: {color: '#898781', size: 11}}
    ]
  };
}
function coverageLayout(title, scale, logRange) {
  const g = depthGuides();
  return {
    autosize: true, height: FIG_HEIGHT, title: title ? {text: title} : undefined,
    margin: {l: 60, r: 30, t: title ? 50 : 24, b: 60},
    paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
    font: themeFont(),
    xaxis: {title: {text: 'Genome position'}, gridcolor: 'rgba(137,135,129,0.25)', zeroline: false},
    yaxis: depthYAxis(scale, logRange),
    hovermode: 'x unified', showlegend: false,
    shapes: g.shapes, annotations: g.annotations
  };
}
// Honest zeros: on a linear axis plot raw depth (0 on the baseline); on a log
// axis break the line at true zeros (null) so no-coverage reads as a gap, never
// a false depth of 1.
function depthForScale(y, scale) {
  return scale === 'log' ? y.map(function (v) { return v > 0 ? v : null; }) : y;
}

/* ---- shared stats-table renderer (values are pre-formatted server-side) ---- */
function statsTableHTML(rows) {
  if (!rows.length) return '';
  const cols = Object.keys(rows[0]);
  let html = '<table class="stats-table"><thead><tr>';
  cols.forEach(function (c) { html += '<th>' + c + '</th>'; });
  html += '</tr></thead><tbody>';
  rows.forEach(function (r) {
    html += '<tr>';
    cols.forEach(function (c) { html += '<td>' + r[c] + '</td>'; });
    html += '</tr>';
  });
  return html + '</tbody></table>';
}

/* ---- "By sample" view: one sample, its coverage across segments ---- */
var covScale = 'linear';
var currentSample = null;
function plotCoverage(holderId, entries, labelFor, scale) {
  const holder = document.getElementById(holderId);
  if (!holder) return;
  holder.innerHTML = '';
  entries.forEach(function (e, i) {
    const div = document.createElement('div');
    div.id = holderId + '-' + i;
    holder.appendChild(div);
    const trace = {x: e.x, y: depthForScale(e.y, scale), mode: 'lines',
                   line: {width: 2, color: '#2a78d6'}, name: labelFor(e), connectgaps: false};
    Plotly.newPlot(div, [trace], coverageLayout(labelFor(e), scale, e.logRange),
                   {responsive: true, displayModeBar: false});
  });
}
function showSample(sample) {
  currentSample = sample;
  const entries = COVERAGE[sample] || [];
  plotCoverage('sample-coverage', entries, function (e) {
    return e.label ? (sample + ' — ' + e.label) : sample;
  }, covScale);
  renderSampleStats(sample);
}
function renderSampleStats(sample) {
  const box = document.getElementById('sample-stats');
  if (box) box.innerHTML = statsTableHTML(STATS[sample] || []);
}
// Collapse the "Coverage by sample" card into a <details> so run-level cards
// lead and per-sample detail is opt-in and lazily rendered.
function makeSampleSectionCollapsible() {
  const card = Array.from(document.querySelectorAll('main .card')).find(function (c) {
    const h = c.querySelector('h2');
    return h && /Coverage by sample/i.test(h.textContent);
  });
  if (!card) return null;
  const h2 = card.querySelector('h2');
  if (!h2) return null;
  const details = document.createElement('details');
  details.className = 'sample-details';
  const summary = document.createElement('summary');
  const title = document.createElement('span');
  title.className = 'sample-summary-title'; title.textContent = 'By sample';
  const hint = document.createElement('span');
  hint.className = 'sample-summary-hint'; hint.textContent = 'Coverage and depth for one sample';
  summary.appendChild(title); summary.appendChild(hint);
  details.appendChild(summary);
  const body = document.createElement('div');
  body.className = 'sample-details-body';
  let node = h2.nextSibling;
  while (node) { const next = node.nextSibling; body.appendChild(node); node = next; }
  details.appendChild(body);
  h2.remove();
  card.appendChild(details);
  return details;
}
function injectCoverageToggle() {
  const sel = document.getElementById('sampleSelect');
  if (!sel) return;
  const toggle = scaleToggleEl('linear', function (s) {
    covScale = s;
    if (currentSample) showSample(currentSample);
  });
  toggle.style.margin = '0 0 14px 8px';
  sel.insertAdjacentElement('afterend', toggle);
}

/* ---- "By segment" view: one segment, its coverage across every sample ----
   For a segmented genome a Segment selector picks the segment; for an
   unsegmented genome there is a single whole-genome "segment", so no selector —
   it just stacks every sample's coverage. Only built when coverage exists. */
var segCovScale = 'linear';
var currentSegment = null;
function rowsForSegment(segment) {
  const rows = [];
  Object.keys(STATS).forEach(function (sample) {
    (STATS[sample] || []).forEach(function (r) { if ((r.Segment || '') === segment) rows.push(r); });
  });
  return rows;
}
function showSegment(segment) {
  currentSegment = segment;
  const entries = [];
  Object.keys(COVERAGE).forEach(function (sample) {
    (COVERAGE[sample] || []).forEach(function (e) {
      if ((e.label || '') === segment) entries.push({_sample: sample, x: e.x, y: e.y, logRange: e.logRange, label: e.label});
    });
  });
  plotCoverage('segment-coverage', entries, function (e) {
    return segment ? (e._sample + ' — ' + segment) : e._sample;
  }, segCovScale);
  // The per-segment stats table (one row per sample) is a useful focused subset
  // for a segmented run; for an unsegmented run it would duplicate Assembly
  // statistics, so it is omitted.
  const box = document.getElementById('segment-stats');
  if (box) box.innerHTML = segment ? statsTableHTML(rowsForSegment(segment)) : '';
}
function buildSegmentSection() {
  const samples = Object.keys(COVERAGE);
  if (!samples.length) return;
  const labels = (COVERAGE[samples[0]] || []).map(function (e) { return e.label; });
  if (!labels.length) return;
  const labeled = labels.filter(function (l) { return l && l.length; });
  const isSegmented = labeled.length > 0;
  const segList = isSegmented ? labeled : [''];
  let segChoice = segList[0];

  let sampleCard = document.querySelector('.sample-details');
  sampleCard = sampleCard ? sampleCard.closest('.card') : null;
  if (!sampleCard) return;

  const card = document.createElement('div');
  card.className = 'card';
  const details = document.createElement('details');
  details.className = 'sample-details';
  const summary = document.createElement('summary');
  const title = document.createElement('span'); title.className = 'sample-summary-title'; title.textContent = 'By segment';
  const hint = document.createElement('span'); hint.className = 'sample-summary-hint';
  hint.textContent = isSegmented ? 'Coverage and depth for one segment, across samples'
                                 : 'Coverage and depth across all samples';
  summary.appendChild(title); summary.appendChild(hint);
  details.appendChild(summary);

  const body = document.createElement('div'); body.className = 'sample-details-body';
  const controls = document.createElement('div'); controls.className = 'chart-controls';
  if (segList.length > 1) {
    const lab = document.createElement('label'); lab.className = 'control'; lab.setAttribute('for', 'segmentSelect'); lab.textContent = 'Segment';
    const sel = document.createElement('select'); sel.id = 'segmentSelect';
    segList.forEach(function (sg) { const o = document.createElement('option'); o.value = sg; o.textContent = sg; sel.appendChild(o); });
    sel.addEventListener('change', function () { segChoice = sel.value; showSegment(segChoice); });
    controls.appendChild(lab); controls.appendChild(sel);
  }
  controls.appendChild(scaleToggleEl('linear', function (s) { segCovScale = s; showSegment(segChoice); }));
  body.appendChild(controls);
  const stats = document.createElement('div'); stats.id = 'segment-stats'; body.appendChild(stats);
  const cov = document.createElement('div'); cov.id = 'segment-coverage'; cov.className = 'plot-holder'; body.appendChild(cov);
  details.appendChild(body);
  card.appendChild(details);
  sampleCard.insertAdjacentElement('afterend', card);

  let rendered = false;
  details.addEventListener('toggle', function () {
    if (details.open && !rendered) { rendered = true; showSegment(segChoice); }
  });
}

/* ---- aggregated-coverage Linear/Log10 toggle (server-rendered linear first) ----
   Rebuilds every segment panel via Plotly.react on toggle (never a yaxis.type
   relayout). The Log10 range is derived from the plotted data max. */
function aggMax(gd) {
  let mx = 0;
  (gd._fullData || gd.data || []).forEach(function (t) {
    const y = t.y; if (y && y.length) for (let i = 0; i < y.length; i++) { if (y[i] > mx) mx = y[i]; }
  });
  return mx;
}
function aggregatedLayout(scale, mx) {
  const logRange = [0, Math.log10(Math.max(150, mx * 1.5))];
  const g = depthGuides();
  return {
    autosize: true, height: FIG_HEIGHT, margin: {l: 60, r: 30, t: 24, b: 60},
    paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)', font: themeFont(),
    xaxis: {title: {text: 'Genome position'}, gridcolor: 'rgba(137,135,129,0.25)', zeroline: false},
    yaxis: scale === 'log' ? depthYAxis('log', logRange) : {title: {text: 'Depth'}, type: 'linear', range: [0, mx * 1.08], gridcolor: 'rgba(137,135,129,0.25)', zeroline: false},
    hovermode: 'x unified', showlegend: false, shapes: g.shapes, annotations: g.annotations
  };
}
function enhanceAggregatedToggle() {
  if (!window.Plotly) return;
  const card = Array.from(document.querySelectorAll('main .card')).find(function (c) {
    const h = c.querySelector('h2');
    return h && /^Aggregated coverage/i.test(h.textContent);
  });
  if (!card) return;
  const setScale = function (s) {
    card.querySelectorAll('.js-plotly-plot').forEach(function (gd) {
      try { Plotly.react(gd, gd.data, aggregatedLayout(s, aggMax(gd) || 1), {responsive: true, displayModeBar: false}); } catch (e) {}
    });
  };
  const toggle = scaleToggleEl('linear', setScale);
  // Place the toggle after the segment selector when present, else after the heading.
  (card.querySelector('select') || card.querySelector('h2')).insertAdjacentElement('afterend', toggle);
}

/* ---- KPI tiles: Global | Per-segment switch (segmented runs only) ---- */
var GROUP_KPI = new Intl.NumberFormat('en-US');   // en-US pinned (see number-format gotcha)
function kfmtDepth(v) {
  if (v == null || !isFinite(v)) return '—';
  return GROUP_KPI.format(Math.round(v * 10) / 10) + '×';
}
function renderKpi(block) {
  var g = document.getElementById('kpi-grid');
  if (!g || !block) return;
  var set = function (key, text) {
    var el = g.querySelector('[data-kpi="' + key + '"]');
    if (el) el.textContent = text;
  };
  set('samples', GROUP_KPI.format(block.samples));
  set('ge90', GROUP_KPI.format(block.ge90));
  set('ge70', GROUP_KPI.format(block.ge70));
  set('median_depth', kfmtDepth(block.median_depth));
  set('ge90_sub', 'of ' + GROUP_KPI.format(block.samples) + ' samples');
  set('ge70_sub', 'of ' + GROUP_KPI.format(block.samples) + ' samples');
}
function initKpiControls() {
  var scope = document.getElementById('kpi-scope');
  if (!scope) return;                       // unsegmented: global tiles only
  var sel = document.getElementById('kpiSegmentSelect');
  var lab = document.getElementById('kpiSegmentLabel');
  var apply = function (mode) {
    var perSeg = mode === 'segment';
    sel.style.display = perSeg ? '' : 'none';
    lab.style.display = perSeg ? '' : 'none';
    renderKpi(perSeg ? (KPI.per_segment[sel.value] || KPI.global) : KPI.global);
  };
  scope.querySelectorAll('button').forEach(function (b) {
    b.addEventListener('click', function () {
      scope.querySelectorAll('button').forEach(function (x) { x.classList.remove('active'); });
      b.classList.add('active');
      apply(b.getAttribute('data-scope'));
    });
  });
  sel.addEventListener('change', function () { renderKpi(KPI.per_segment[sel.value] || KPI.global); });
}

/* ---- init ---- */
window.addEventListener('load', function () {
  themeCharts();
  initKpiControls();
  enhanceSortHeaders();
  enhanceAggregatedToggle();
  // The eyebrow over the collapsible section now holds both a by-sample and a
  // by-segment view, so it reads "Details".
  document.querySelectorAll('.section-title').forEach(function (s) {
    if (/per[-\s]?sample/i.test(s.textContent)) s.textContent = 'Details';
  });
  const details = makeSampleSectionCollapsible();
  injectCoverageToggle();
  buildSegmentSection();
  const first = document.getElementById('sampleSelect');
  if (details) {
    // Lazy: build the per-sample plot only when the section is first expanded.
    let rendered = false;
    details.addEventListener('toggle', function () {
      if (details.open && !rendered && first && first.value) { rendered = true; showSample(first.value); }
    });
  } else if (first && first.value) {
    showSample(first.value);
  }
});
</script>
</body>
