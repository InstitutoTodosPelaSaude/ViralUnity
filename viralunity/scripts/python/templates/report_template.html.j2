<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>ViralUnity consensus report</title>
<script>{{ plotly_js|safe }}</script>
<style>
:root {
  --page-bg: #f9f9f7;
  --card-bg: #fcfcfb;
  --text-primary: #0b0b0b;
  --text-secondary: #52514e;
  --text-muted: #898781;
  --border: rgba(11,11,11,0.10);
  --accent: #2a78d6;
  --hover: rgba(42,120,214,0.08);
  /* Coverage status tiers (constant hue across themes; faint fills differ). */
  --status-pass: #1b9e5a;
  --status-warn: #e0a100;
  --status-fail: #e34948;
  --status-fail-fill: rgba(227,73,72,0.08);
  --status-warn-fill: rgba(224,161,0,0.10);
  --status-pass-fill: rgba(27,158,90,0.10);
  --input: #ffffff;
  --subrow: #f4f4f2;
  --selrow: rgba(42,120,214,0.12);
  --rowhover: rgba(42,120,214,0.08);
}
:root[data-theme="dark"] {
  --page-bg: #0d0d0d;
  --card-bg: #1a1a19;
  --text-primary: #ffffff;
  --text-secondary: #c3c2b7;
  --text-muted: #898781;
  --border: rgba(255,255,255,0.10);
  --accent: #3987e5;
  --hover: rgba(57,135,229,0.12);
  --status-pass: #1b9e5a;
  --status-warn: #e0a100;
  --status-fail: #e34948;
  --status-fail-fill: rgba(227,73,72,0.16);
  --status-warn-fill: rgba(224,161,0,0.18);
  --status-pass-fill: rgba(27,158,90,0.16);
  --input: #232322;
  --subrow: #141413;
  --selrow: rgba(57,135,229,0.20);
  --rowhover: rgba(57,135,229,0.12);
}
* { box-sizing: border-box; }
body {
  margin: 0;
  font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
  background: var(--page-bg);
  color: var(--text-primary);
  line-height: 1.5;
}
header {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20px 28px; border-bottom: 1px solid var(--border);
}
header h1 { font-size: 1.25rem; margin: 0; font-weight: 600; }
main { max-width: 1000px; margin: 0 auto; padding: 24px 20px 64px; }
.section-title {
  font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--text-muted); margin: 28px 4px 12px;
}
.card {
  background: var(--card-bg); border: 1px solid var(--border);
  border-radius: 14px; padding: 20px 22px; margin-bottom: 18px;
  overflow-x: auto;
}
.card h2 { font-size: 1rem; margin: 0 0 14px; font-weight: 600; }
.theme-toggle {
  background: var(--card-bg); border: 1px solid var(--border);
  color: var(--text-secondary); border-radius: 8px; padding: 7px 12px;
  cursor: pointer; font-size: 0.85rem;
}
.theme-toggle:hover { background: var(--hover); }
select {
  background: var(--card-bg); border: 1px solid var(--border);
  color: var(--text-primary); border-radius: 8px; padding: 7px 10px;
  font-size: 0.9rem; margin: 0 8px 14px 0;
}
label.control { font-size: 0.85rem; color: var(--text-secondary); margin-right: 6px; }
table.stats-table { border-collapse: collapse; width: 100%; font-size: 0.85rem; }
table.stats-table th, table.stats-table td {
  padding: 7px 14px; text-align: center; white-space: nowrap;
  border-bottom: 1px solid var(--border); font-variant-numeric: tabular-nums;
}
/* Numeric columns right-aligned (tabular); the Sample identity column left. */
table.stats-table td.num, table.stats-table th.th-num { text-align: right; }
table.stats-table td.cell-sample, table.stats-table th.col-freeze { text-align: left; }
table.stats-table th {
  cursor: pointer; user-select: none; color: var(--text-secondary);
  font-weight: 600; position: sticky; top: 0; background: var(--card-bg); z-index: 2;
}
/* Freeze the first (Sample) column when the table scrolls sideways on narrow
   screens; the header corner needs the higher z so it stays above both. */
.table-scroll { overflow-x: auto; }
table.stats-table td.col-freeze, table.stats-table th.col-freeze {
  position: sticky; left: 0; background: var(--card-bg); z-index: 1;
}
table.stats-table th.col-freeze { z-index: 3; }
/* Table controls (search + low-coverage filter + row count). */
.table-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; margin-bottom: 12px; }
.table-search {
  background: var(--input, var(--card-bg)); border: 1px solid var(--border);
  color: var(--text-primary); border-radius: 8px; padding: 7px 12px;
  font-size: 0.85rem; min-width: 220px; flex: 0 1 280px;
}
.table-search:focus-visible { outline: 2px solid var(--accent); outline-offset: -1px; }
.chip-toggle {
  background: var(--card-bg); border: 1px solid var(--border); color: var(--text-secondary);
  border-radius: 8px; padding: 7px 12px; font: inherit; font-size: 0.82rem; cursor: pointer;
}
.chip-toggle:hover { background: var(--hover); }
.chip-toggle[aria-pressed="true"] { background: var(--status-fail); border-color: var(--status-fail); color: #fff; }
.chip-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
.row-count { font-size: 0.8rem; color: var(--text-secondary); margin-left: auto; }
/* Coverage status encodings (never colour-alone: dot + tinted value + bar). */
.cov-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 8px; vertical-align: baseline; }
.cov-dot-pass { background: var(--status-pass); }
.cov-dot-warn { background: var(--status-warn); }
.cov-dot-fail { background: var(--status-fail); }
.cov-cell { position: relative; }
.cov-val { font-weight: 600; }
.cov-pass { color: var(--status-pass); }
.cov-warn { color: var(--status-warn); }
.cov-fail { color: var(--status-fail); }
.cov-bar { position: absolute; left: 0; bottom: 0; height: 3px; border-radius: 0 2px 2px 0; }
.cov-bar-pass { background: var(--status-pass); }
.cov-bar-warn { background: var(--status-warn); }
.cov-bar-fail { background: var(--status-fail); }
tr.row-hidden { display: none; }
/* Segmented roll-up: summary rows carry a caret + "N segments" tag; subrows are
   indented and muted, revealed when the parent row is expanded. */
.seg-summary { cursor: pointer; }
.seg-summary:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
.seg-caret::before { content: '\25B8'; color: var(--text-muted); font-size: 0.85em; margin-right: 8px; display: inline-block; transition: transform 0.15s ease; }
.seg-summary.open .seg-caret::before { transform: rotate(90deg); }
.seg-tag { margin-left: 10px; font-size: 0.72rem; font-weight: 400; color: var(--text-muted); background: var(--chip, var(--subrow)); border-radius: 10px; padding: 1px 8px; }
.seg-subrow > td { background: var(--subrow); }
.cell-subrow { padding-left: 34px; color: var(--text-secondary); }
.cell-muted { color: var(--text-muted); }
@media (prefers-reduced-motion: reduce) { .seg-caret::before { transition: none; } }
/* Segment selector chips (focus the table on All or one segment). */
.seg-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
.seg-chip { background: var(--card-bg); border: 1px solid var(--border); color: var(--text-secondary); border-radius: 8px; padding: 5px 12px; font: inherit; font-size: 0.8rem; cursor: pointer; }
.seg-chip:hover { background: var(--hover); }
.seg-chip.active { background: var(--accent); border-color: var(--accent); color: #fff; }
.seg-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
table.stats-table th:hover { color: var(--text-primary); }
table.stats-table tbody tr:hover { background: var(--hover); }
/* Client-rendered per-sample/per-segment tables are read-only (not sortable), so
   they must not advertise a sort affordance. */
table.stats-table.stats-static th { cursor: default; }
table.stats-table.stats-static th:hover { color: var(--text-secondary); }
.sort-arrow { font-size: 0.7em; color: var(--text-muted); margin-left: 4px; }
.plot-holder { min-height: 60px; }
.chart-note { font-size: 0.8rem; color: var(--text-muted); margin: 8px 4px 0; }
.run-meta { font-size: 0.85rem; color: var(--text-secondary); margin: 0 4px 16px; }
/* Charts fill the card (responsive) but never stretch past their design width. */
.card .plotly-graph-div, .card .js-plotly-plot { width: 100%; max-width: 900px; }
/* Separate the per-sample stats table from the coverage plot(s) below it; the
   table's own last-row hairline reads cleanly, so spacing alone suffices. */
#sample-coverage, #segment-coverage { margin-top: 28px; }
/* Stacked coverage plots (one per segment, or one per sample in the by-segment
   view) get breathing room and a hairline divider so each reads as its own panel. */
#sample-coverage > div + div, #segment-coverage > div + div {
  margin-top: 32px; padding-top: 28px; border-top: 1px solid var(--border);
}
/* Linear/Log10 toggle */
.scale-toggle { display: inline-flex; border: 1px solid var(--border); border-radius: 7px; overflow: hidden; vertical-align: middle; margin: 0 0 14px; }
.scale-toggle button { border: none; background: var(--card-bg); color: var(--text-secondary); font: inherit; font-size: 0.8rem; padding: 6px 12px; cursor: pointer; }
.scale-toggle button + button { border-left: 1px solid var(--border); }
.scale-toggle button.active { background: var(--accent); color: #fff; }
.scale-toggle button:hover:not(.active) { background: var(--hover); }
.scale-toggle button:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
.chart-controls { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; margin-bottom: 10px; }
.chart-controls .scale-toggle { margin: 0; }
/* Separate the Genes/Primers track toggles from the scale toggle so the two
   groups read as distinct controls (also covers the aggregated card, where they
   are adjacent inline-flex siblings rather than flex-gap children). */
.track-toggles { margin-left: 18px; }
table.stats-table th[role="button"]:focus-visible { outline: 2px solid var(--accent); outline-offset: -2px; }
/* Progressive disclosure: per-sample / per-segment detail behind a collapsed accordion. */
.sample-details > summary { cursor: pointer; list-style: none; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.sample-details > summary::-webkit-details-marker { display: none; }
.sample-details > summary::before { content: '\25B8'; color: var(--text-muted); font-size: 0.85em; transition: transform 0.15s ease; }
.sample-details[open] > summary::before { transform: rotate(90deg); }
.sample-details > summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
.sample-summary-title { font-size: 1rem; font-weight: 600; }
.sample-summary-hint { font-size: 0.8rem; color: var(--text-muted); font-weight: 400; }
.sample-details-body { margin-top: 18px; }
@media (prefers-reduced-motion: reduce) { .sample-details > summary::before { transition: none; } }
/* KPI summary tiles (big BI-style numbers). Values wear text tokens, not a
   series colour; proportional figures (not tabular) so a big number isn't loose. */
.kpi-controls { margin: 4px 0 12px; }
.kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; margin-bottom: 8px; }
.kpi-tile { background: var(--card-bg); border: 1px solid var(--border); border-radius: 14px; padding: 18px 20px; }
/* The "Below warn%" tile turns red only when the count is non-zero — the "how
   many need attention" signal. Neutral (like every other tile) when zero. */
.kpi-tile-alert { border-color: var(--status-fail); background: var(--status-fail-fill); }
.kpi-tile-alert .kpi-value { color: var(--status-fail); }
.kpi-value { font-size: 2rem; font-weight: 600; line-height: 1.1; color: var(--text-primary); font-variant-numeric: proportional-nums; }
.kpi-label { font-size: 0.85rem; color: var(--text-secondary); margin-top: 6px; }
.kpi-sub { font-size: 0.78rem; color: var(--text-muted); margin-top: 2px; }
/* Run-parameters slide-over drawer (a memory of exactly what was run). */
.header-actions { display: flex; gap: 8px; align-items: center; }
.params-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.4); z-index: 40; }
.params-drawer {
  position: fixed; top: 0; right: 0; height: 100%; width: min(460px, 92vw);
  background: var(--card-bg); border-left: 1px solid var(--border);
  box-shadow: -8px 0 24px rgba(0,0,0,0.18); z-index: 50;
  display: flex; flex-direction: column; transform: translateX(0);
}
.params-drawer[hidden], .params-overlay[hidden] { display: none; }
.params-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 16px 20px; border-bottom: 1px solid var(--border);
}
.params-title { font-size: 1rem; font-weight: 600; }
.params-close {
  background: none; border: none; color: var(--text-secondary);
  font-size: 1.4rem; line-height: 1; cursor: pointer; padding: 0 4px;
}
.params-close:hover { color: var(--text-primary); }
.params-close:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 4px; }
.params-body { overflow-y: auto; padding: 8px 20px 24px; }
.cfg-section {
  font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em;
  color: var(--text-muted); margin: 20px 0 8px;
}
.cfg-block { display: flex; flex-direction: column; }
.cfg-row {
  display: grid; grid-template-columns: minmax(120px, 40%) 1fr; gap: 12px;
  padding: 6px 0; border-bottom: 1px solid var(--border); font-size: 0.83rem;
}
.cfg-key { color: var(--text-secondary); word-break: break-word; }
.cfg-val { color: var(--text-primary); word-break: break-word; font-variant-numeric: tabular-nums; }
.cfg-null { color: var(--text-muted); }
.cfg-nested { display: flex; flex-direction: column; gap: 2px; }
.cfg-nested .cfg-row { border-bottom: none; padding: 2px 0; grid-template-columns: minmax(80px, 45%) 1fr; }
.cfg-list { margin: 0; padding-left: 16px; }
@media (prefers-reduced-motion: no-preference) {
  .params-drawer { animation: params-slide 0.16s ease-out; }
  @keyframes params-slide { from { transform: translateX(100%); } to { transform: translateX(0); } }
}
</style>
</head>
<body data-palette="{{ palette_light|join(',') }}" data-palette-dark="{{ palette_dark|join(',') }}"
      data-track-genes="{{ track_genes }}" data-track-primers="{{ track_primers }}">
<header>
  <h1>ViralUnity consensus report{% if segmented %} <span style="color:var(--text-muted);font-weight:400">· segmented</span>{% endif %}</h1>
  <div class="header-actions">
    {% if config_panel_html %}<button class="theme-toggle" id="params-btn" onclick="openParams()" aria-haspopup="dialog" aria-expanded="false" aria-controls="params-drawer">Parameters</button>{% endif %}
    <button class="theme-toggle" onclick="toggleTheme()" id="theme-btn">Dark mode</button>
  </div>
</header>
<main>

  <p class="section-title">Summary</p>
  {% if segmented %}
  <div class="chart-controls kpi-controls">
    <div class="scale-toggle" role="group" aria-label="KPI scope" id="kpi-scope">
      <button type="button" class="active" data-scope="global" aria-pressed="true">Global</button>
      <button type="button" data-scope="segment" aria-pressed="false">Per segment</button>
    </div>
    <label class="control" for="kpiSegmentSelect" id="kpiSegmentLabel" style="display:none">Segment</label>
    <select id="kpiSegmentSelect" style="display:none">
      {% for s in segments %}<option value="{{ s }}">{{ s }}</option>{% endfor %}
    </select>
  </div>
  {% endif %}
  <div class="kpi-grid" id="kpi-grid">
    <div class="kpi-tile">
      <div class="kpi-value" data-kpi="samples">{{ kpi_global.samples }}</div>
      <div class="kpi-label">Samples analyzed</div>
      <div class="kpi-sub">{{ kpi_samples_sub }}</div>
    </div>
    <div class="kpi-tile">
      <div class="kpi-value" data-kpi="pass_count">{{ kpi_global.pass_count }}</div>
      <div class="kpi-label">&ge;{{ params.pass_pct_label }} coverage</div>
      <div class="kpi-sub" data-kpi="pass_sub">{{ kpi_global.pass_sub }}</div>
    </div>
    <div class="kpi-tile{% if kpi_global.below_warn_nonzero %} kpi-tile-alert{% endif %}" id="kpi-warn-tile" data-kpi-tile="below_warn">
      <div class="kpi-value" data-kpi="below_warn">{{ kpi_global.below_warn }}</div>
      <div class="kpi-label">Below {{ params.warn_pct_label }} <span aria-hidden="true">&#9888;</span></div>
      <div class="kpi-sub">need attention</div>
    </div>
    <div class="kpi-tile">
      <div class="kpi-value" data-kpi="median_coverage">{{ kpi_global.median_coverage }}</div>
      <div class="kpi-label">Median coverage</div>
    </div>
    <div class="kpi-tile">
      <div class="kpi-value" data-kpi="mean_depth">{{ kpi_global.mean_depth }}</div>
      <div class="kpi-label">Mean depth</div>
    </div>
  </div>

  <p class="section-title">Overview</p>

  {% if metadata %}
  <p class="run-meta">
    {{ metadata.platform|capitalize }} &middot; {{ metadata.library_layout }}-end
    {%- if not metadata.qc_performed %} &middot; no read-QC step (Nanopore){% endif %}
  </p>
  {% endif %}

  <div class="card" id="stats-card">
    <h2>Assembly statistics</h2>
    {% if segmented %}
    <div class="seg-chips" id="statsSegChips" role="group" aria-label="Focus table on a segment">
      <button type="button" class="seg-chip active" data-seg="" aria-pressed="true">All</button>
      {% for s in segments %}
      <button type="button" class="seg-chip" data-seg="{{ s }}" aria-pressed="false">{{ s }}</button>
      {% endfor %}
    </div>
    {% endif %}
    <div class="table-controls">
      <input type="search" id="statsSearch" class="table-search"
             placeholder="Filter by sample{% if segmented %} or segment{% endif %}…"
             aria-label="Filter table rows by sample{% if segmented %} or segment{% endif %} name">
      <button type="button" id="lowCovToggle" class="chip-toggle" aria-pressed="false"
              title="Show only samples below the {{ params.warn_pct_label }} warn threshold">
        <span aria-hidden="true">&#9888;</span> Low coverage only
      </button>
      <span class="row-count" id="statsRowCount" aria-live="polite"></span>
    </div>
    <div class="table-scroll">{{ stats_table_html|safe }}</div>
  </div>

  <div class="card" id="throughput-card">
    <h2>Sequencing throughput</h2>
    <div class="chart-controls">
      <div class="scale-toggle" role="group" aria-label="Throughput scale" id="throughput-scale">
        <button type="button" class="active" data-mode="absolute" aria-pressed="true">Absolute</button>
        <button type="button" data-mode="percent" aria-pressed="false">Percent</button>
      </div>
    </div>
    {{ reads_fig_html|safe }}
  </div>

  <div class="card" id="aggregated-card">
    <h2>Aggregated coverage</h2>
    {% if segmented %}
    <div>
      <label class="control" for="aggSegmentSelect">Segment</label>
      <select id="aggSegmentSelect" onchange="showPanel('agg-panel', this.value)">
        {% for panel in aggregated_panels %}
        <option value="{{ panel.segment }}">{{ panel.segment }}</option>
        {% endfor %}
      </select>
    </div>
    {% endif %}
    {% for panel in aggregated_panels %}
    <div class="agg-panel" data-key="{{ panel.segment }}"
         data-log-range="{{ panel.log_range|join(',') }}" data-lin-max="{{ panel.lin_max }}"
         style="display: {{ 'block' if loop.first else 'none' }};">
      {{ panel.html|safe }}
    </div>
    {% endfor %}
  </div>

  {% if has_coverage %}
  <p class="section-title">Details</p>

  <div class="card">
    <details class="sample-details" id="by-sample-details">
      <summary>
        <span class="sample-summary-title">By sample</span>
        <span class="sample-summary-hint">Coverage and depth for one sample</span>
      </summary>
      <div class="sample-details-body">
        <div class="chart-controls">
          <label class="control" for="sampleSelect">Sample</label>
          <select id="sampleSelect" onchange="showSample(this.value)">
            {% for s in samples %}<option value="{{ s }}">{{ s }}</option>{% endfor %}
          </select>
        </div>
        <div id="sample-stats"></div>
        <div id="sample-coverage" class="plot-holder"></div>
      </div>
    </details>
  </div>

  <div class="card">
    <details class="sample-details" id="by-segment-details">
      <summary>
        <span class="sample-summary-title">By segment</span>
        <span class="sample-summary-hint">
          {%- if segmented %}Coverage and depth for one segment, across samples
          {%- else %}Coverage and depth across all samples{% endif %}</span>
      </summary>
      <div class="sample-details-body">
        <div class="chart-controls">
          {% if segmented %}
          <label class="control" for="segmentSelect">Segment</label>
          <select id="segmentSelect" onchange="showSegment(this.value)">
            {% for s in segments %}<option value="{{ s }}">{{ s }}</option>{% endfor %}
          </select>
          {% endif %}
        </div>
        <div id="segment-stats"></div>
        <div id="segment-coverage" class="plot-holder"></div>
      </div>
    </details>
  </div>
  {% endif %}

</main>

{% if config_panel_html %}
<div class="params-overlay" id="params-overlay" hidden onclick="closeParams()"></div>
<aside class="params-drawer" id="params-drawer" role="dialog" aria-modal="true" aria-label="Run parameters" hidden>
  <div class="params-head">
    <span class="params-title">Run parameters</span>
    <button class="params-close" id="params-close" onclick="closeParams()" aria-label="Close parameters">&times;</button>
  </div>
  <div class="params-body">{{ config_panel_html|safe }}</div>
</aside>
{% endif %}

<script id="coverageData" type="application/json">{{ coverage_json|safe }}</script>
<script id="statsData" type="application/json">{{ stats_by_sample|safe }}</script>
<script id="kpiData" type="application/json">{{ kpi_json|safe }}</script>
<script id="annotationData" type="application/json">{{ annotation_json|safe }}</script>
<script id="paramsData" type="application/json">{{ params_json|safe }}</script>
<script>
const COVERAGE = JSON.parse(document.getElementById('coverageData').textContent);
const STATS = JSON.parse(document.getElementById('statsData').textContent);
const KPI = JSON.parse(document.getElementById('kpiData').textContent);
// Per-segment annotation tracks (gene + primer lanes); {} when none were staged.
const ANNOT = JSON.parse(document.getElementById('annotationData').textContent);
// Tweakable report params (thresholds/colours); the single client source for
// threshold-derived labels and the accent/status hues (spec §9).
const PARAMS = JSON.parse(document.getElementById('paramsData').textContent);
const FIG_WIDTH = 900, FIG_HEIGHT = 420;

/* ---- theme ---- */
function isDark() { return document.documentElement.getAttribute('data-theme') === 'dark'; }
// Colourblind-safe categorical palettes (light/dark), read from the server-set
// body attributes so Python stays the single source of the hues.
function seriesPalette() {
  const attr = isDark() ? 'data-palette-dark' : 'data-palette';
  return (document.body.getAttribute(attr) || '').split(',');
}
function toggleTheme() {
  const dark = !isDark();
  document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
  document.getElementById('theme-btn').textContent = dark ? 'Light mode' : 'Dark mode';
  themeCharts();
}
function themeCharts() {
  // Gridlines use a semi-transparent gray that reads on both themes, so only
  // the font colour needs to flip. Applying font.color globally also covers
  // multi-axis subplots (the reads figure) that per-axis keys would miss.
  const dark = isDark();
  const upd = {
    'font.color': dark ? '#c3c2b7' : '#52514e',
    'paper_bgcolor': 'rgba(0,0,0,0)',
    'plot_bgcolor': 'rgba(0,0,0,0)',
  };
  document.querySelectorAll('.js-plotly-plot').forEach(function (gd) {
    try { Plotly.relayout(gd, upd); } catch (e) { /* not yet drawn */ }
  });
  recolorCharts();
}
// Series hues are theme-specific (the light hexes are not contrast-safe on the
// dark surface), so restyle each chart's colours when the theme flips. Server-
// rendered figures start in the light palette; this brings them to the dark set.
function recolorCharts() {
  if (!window.Plotly) return;
  const pal = seriesPalette();
  if (!pal.length || !pal[0]) return;
  // Single-hue coverage line charts (by sample / by segment / aggregated).
  document.querySelectorAll('#sample-coverage .js-plotly-plot, #segment-coverage .js-plotly-plot')
    .forEach(function (gd) { try { Plotly.restyle(gd, {'line.color': pal[0]}); } catch (e) {} });
  // Aggregated coverage: one line per sample (categorical), except the >8-series
  // emphasis fallback which is a single theme-neutral muted grey — leave it be.
  document.querySelectorAll('#aggregated-card .js-plotly-plot').forEach(function (gd) {
    const n = (gd.data || []).length;
    if (n === 0 || n > 8) return;
    try { Plotly.restyle(gd, {'line.color': pal.slice(0, n)}); } catch (e) {}
  });
  // Sequencing throughput: mapped (accent) + QC-passed-unmapped (green) recolour
  // by theme; "Removed by QC" stays the theme-neutral muted grey (index 2).
  const tc = document.getElementById('throughput-card');
  if (tc) tc.querySelectorAll('.js-plotly-plot').forEach(function (gd) {
    try { Plotly.restyle(gd, {'marker.color': [pal[0]]}, [0]); } catch (e) {}
    try { Plotly.restyle(gd, {'marker.color': [pal[1]]}, [1]); } catch (e) {}
  });
  // Annotation-track bars carry their kind on the trace; recolour each to the
  // theme's track hue (trackColors reads the theme). Targeted by index so the
  // depth line and sample series in the same figure are untouched.
  document.querySelectorAll('.js-plotly-plot').forEach(function (gd) {
    (gd.data || []).forEach(function (tr, i) {
      if (!tr._track) return;
      const c = trackColors(tr._trackKind);
      try { Plotly.restyle(gd, {'marker.color': c.fill, 'marker.line.color': c.line}, [i]); } catch (e) {}
    });
  });
}

/* ---- generic display:none panel toggle (aggregated segment switch) ---- */
function showPanel(cls, key) {
  document.querySelectorAll('.' + cls).forEach(function (p) {
    p.style.display = (p.getAttribute('data-key') === key) ? 'block' : 'none';
  });
  themeCharts();
}

/* ---- client-side table sort ---- */
function sortTable(th) {
  const table = th.closest('table');
  const idx = parseInt(th.getAttribute('data-col'), 10);
  const asc = th.getAttribute('data-asc') !== 'true';
  const rows = Array.from(table.tBodies[0].rows);
  rows.sort(function (a, b) {
    const av = a.cells[idx].getAttribute('data-sort');
    const bv = b.cells[idx].getAttribute('data-sort');
    const an = parseFloat(av), bn = parseFloat(bv);
    let cmp;
    if (!isNaN(an) && !isNaN(bn)) cmp = an - bn;
    else cmp = String(av).localeCompare(String(bv));
    return asc ? cmp : -cmp;
  });
  rows.forEach(function (r) { table.tBodies[0].appendChild(r); });
  table.querySelectorAll('th').forEach(function (h) {
    h.setAttribute('data-asc', 'false');
    if (h.hasAttribute('aria-sort')) h.setAttribute('aria-sort', 'none');
    const arr = h.querySelector('.sort-arrow'); if (arr) arr.textContent = '';
  });
  th.setAttribute('data-asc', asc ? 'true' : 'false');
  if (th.hasAttribute('aria-sort')) th.setAttribute('aria-sort', asc ? 'ascending' : 'descending');
  const arrow = th.querySelector('.sort-arrow'); if (arrow) arrow.textContent = asc ? '▲' : '▼';
}

/* ---- sortable-header keyboard access (attrs are emitted server-side) ---- */
function enhanceSortHeaders() {
  document.querySelectorAll('table.stats-table th[onclick]').forEach(function (th) {
    th.addEventListener('keydown', function (ev) {
      if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); th.click(); }
    });
  });
}

/* ---- assembly-stats search + "low coverage only" filter + roll-up + chips ----
   Applies the current view to #stats-table: a sample/segment search substring, an
   optional "below the warn threshold" filter, the segmented roll-up (caret-
   expandable subrows), and the segment-focus chips (All ⇄ one segment). Row
   visibility is a CSS class so it survives column re-sorts; the row-count label
   updates live. */
var statsSegMode = '';                 // '' = All (roll-up), else a segment name
var statsExpanded = {};                // sid -> true for expanded summary rows
function _statsQuery() {
  var el = document.getElementById('statsSearch');
  return (el && el.value ? el.value : '').trim().toLowerCase();
}
function _statsLowOnly() {
  var el = document.getElementById('lowCovToggle');
  return !!(el && el.getAttribute('aria-pressed') === 'true');
}
function _statsWarn() {
  return (PARAMS && typeof PARAMS.warnThreshold === 'number') ? PARAMS.warnThreshold : 0.70;
}
function applyStatsView() {
  var table = document.getElementById('stats-table');
  if (!table || !table.tBodies[0]) return;
  var rows = Array.from(table.tBodies[0].rows);
  var q = _statsQuery(), lowOnly = _statsLowOnly(), warn = _statsWarn();
  var segmented = !!document.getElementById('statsSegChips');
  var shown = 0, total = 0, unit = 'samples';

  var rowMatches = function (r) {
    var name = (r.getAttribute('data-sample') || '').toLowerCase();
    var seg = (r.getAttribute('data-segment') || '').toLowerCase();
    var cov = parseFloat(r.getAttribute('data-coverage'));
    var matchQ = !q || name.indexOf(q) !== -1 || (seg && seg.indexOf(q) !== -1);
    var matchLow = !lowOnly || (isFinite(cov) && cov < warn);
    return matchQ && matchLow;
  };

  if (!segmented) {
    rows.forEach(function (r) {
      total++;
      var show = rowMatches(r);
      r.classList.toggle('row-hidden', !show);
      if (show) shown++;
    });
  } else if (statsSegMode === '') {
    // Roll-up view: summary rows drive counting/visibility; subrows appear only
    // when their (visible) parent is expanded.
    rows.forEach(function (r) {
      if (r.getAttribute('data-role') !== 'summary') return;
      total++;
      var show = rowMatches(r);
      r.classList.toggle('row-hidden', !show);
      if (show) shown++;
      var open = !!statsExpanded[r.getAttribute('data-sid')];
      r.classList.toggle('open', open);
      r.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    rows.forEach(function (r) {
      if (r.getAttribute('data-role') !== 'subrow') return;
      var parent = table.querySelector(
        'tr.seg-summary[data-sid="' + r.getAttribute('data-parent') + '"]');
      var vis = parent && !parent.classList.contains('row-hidden') &&
                parent.classList.contains('open');
      r.classList.toggle('row-hidden', !vis);
    });
  } else {
    // Single-segment flat view: hide summaries, show matching subrows only.
    unit = 'segments';
    rows.forEach(function (r) {
      var role = r.getAttribute('data-role');
      if (role === 'summary' || r.getAttribute('data-segment') !== statsSegMode) {
        r.classList.add('row-hidden');
        return;
      }
      total++;
      var show = rowMatches(r);
      r.classList.toggle('row-hidden', !show);
      if (show) shown++;
    });
  }
  var label = document.getElementById('statsRowCount');
  if (label) label.textContent = shown + ' of ' + total + ' ' + unit;
}
function initStatsControls() {
  var s = document.getElementById('statsSearch');
  var t = document.getElementById('lowCovToggle');
  if (s) s.addEventListener('input', applyStatsView);
  if (t) t.addEventListener('click', function () {
    t.setAttribute('aria-pressed', t.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
    applyStatsView();
  });
  // Segmented roll-up: caret-expand summary rows (click or Enter/Space).
  var table = document.getElementById('stats-table');
  if (table) {
    table.querySelectorAll('tr.seg-summary').forEach(function (tr) {
      var toggle = function () {
        var sid = tr.getAttribute('data-sid');
        statsExpanded[sid] = !statsExpanded[sid];
        applyStatsView();
      };
      tr.addEventListener('click', toggle);
      tr.addEventListener('keydown', function (ev) {
        if (ev.key === 'Enter' || ev.key === ' ') { ev.preventDefault(); toggle(); }
      });
    });
  }
  // Segment-focus chips (All ⇄ single segment).
  var chipBox = document.getElementById('statsSegChips');
  if (chipBox) {
    chipBox.querySelectorAll('.seg-chip').forEach(function (btn) {
      btn.addEventListener('click', function () {
        chipBox.querySelectorAll('.seg-chip').forEach(function (b) {
          b.classList.remove('active');
          b.setAttribute('aria-pressed', 'false');
        });
        btn.classList.add('active');
        btn.setAttribute('aria-pressed', 'true');
        statsSegMode = btn.getAttribute('data-seg') || '';
        applyStatsView();
      });
    });
  }
  applyStatsView();  // seed the row-count label + initial visibility
}

/* ---- Linear/Log10 scale toggle control ---- */
function themeFont() {
  return {family: 'system-ui, -apple-system, "Segoe UI", sans-serif', size: 13,
          color: isDark() ? '#c3c2b7' : '#52514e'};
}
function scaleToggleEl(initial, onChange) {
  const wrap = document.createElement('div');
  wrap.className = 'scale-toggle';
  wrap.setAttribute('role', 'group');
  wrap.setAttribute('aria-label', 'Y-axis scale');
  ['linear', 'log'].forEach(function (s) {
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = s === 'linear' ? 'Linear' : 'Log10';
    b.setAttribute('data-scale', s);
    b.setAttribute('aria-pressed', s === initial ? 'true' : 'false');
    if (s === initial) b.className = 'active';
    b.addEventListener('click', function () {
      wrap.querySelectorAll('button').forEach(function (x) {
        x.classList.remove('active');
        x.setAttribute('aria-pressed', 'false');
      });
      b.classList.add('active');
      b.setAttribute('aria-pressed', 'true');
      onChange(s);
    });
    wrap.appendChild(b);
  });
  return wrap;
}

/* ---- depth-axis layouts (shared by the coverage line charts) ----
   Depth axes are linear by default; the toggle switches to Log10 by REBUILDING
   the figure (Plotly.react/newPlot), never a relayout that flips yaxis.type —
   that path hits a Plotly slow path (~6s freeze) on the ~2000-point lines. The
   Log10 range comes from Python (entry.logRange), computed once, not re-derived
   here. The y-caption is just "Depth" in both modes (the toggle states the
   scale); log ticks are pinned to powers of ten (dtick 1). */
function depthYAxis(scale, logRange, linRange) {
  const common = {title: {text: 'Depth'}, gridcolor: 'rgba(137,135,129,0.25)', zeroline: false};
  if (scale === 'log') {
    return Object.assign(common, {type: 'log', range: logRange, dtick: 1});
  }
  // Explicit data-fit range (computed once in Python) rather than autorange;
  // fall back to tozero if a range wasn't supplied.
  return linRange
    ? Object.assign(common, {type: 'linear', range: linRange})
    : Object.assign(common, {type: 'linear', rangemode: 'tozero'});
}
function depthGuides() {
  return {
    shapes: [
      {type: 'line', xref: 'x domain', x0: 0, x1: 1, y0: 20, y1: 20, line: {color: '#898781', width: 1, dash: 'dot'}},
      {type: 'line', xref: 'x domain', x0: 0, x1: 1, y0: 100, y1: 100, line: {color: '#898781', width: 1, dash: 'dot'}}
    ],
    annotations: [
      {xref: 'paper', x: 1, y: 20, yref: 'y', text: '20x', showarrow: false, xanchor: 'right', font: {color: '#898781', size: 11}},
      {xref: 'paper', x: 1, y: 100, yref: 'y', text: '100x', showarrow: false, xanchor: 'right', font: {color: '#898781', size: 11}}
    ]
  };
}
function coverageLayout(title, scale, logRange, linRange) {
  const g = depthGuides();
  return {
    autosize: true, height: FIG_HEIGHT, title: title ? {text: title} : undefined,
    margin: {l: 60, r: 30, t: title ? 50 : 24, b: 60},
    paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)',
    font: themeFont(),
    xaxis: {title: {text: 'Genome position'}, gridcolor: 'rgba(137,135,129,0.25)', zeroline: false},
    yaxis: depthYAxis(scale, logRange, linRange),
    hovermode: 'x unified', showlegend: false,
    shapes: g.shapes, annotations: g.annotations
  };
}
// Honest zeros: on a linear axis plot raw depth (0 on the baseline); on a log
// axis break the line at true zeros (null) so no-coverage reads as a gap, never
// a false depth of 1.
function depthForScale(y, scale) {
  return scale === 'log' ? y.map(function (v) { return v > 0 ? v : null; }) : y;
}

/* ---- annotation tracks (genes + primer amplicons) ----
   Drawn as horizontal-bar traces on a second y-axis (y2) beneath the depth
   line, aligned to the same genome x-axis. Traces (not layout shapes) so they
   ride through the Plotly.react scale-toggle rebuild untouched and are
   independent of the depth axis type (the Linear/Log10 toggle only rebuilds
   y). The same helper feeds the aggregated, by-sample and by-segment views. */
// TRACK_GAP_PX is generous on purpose: the depth plot's x-axis ("Genome
// position" title + tick labels) is drawn in this band between the depth plot
// and the track lanes, so it must clear both. TRACK_LANE_PX gives each lane room
// to breathe (and gene labels room to sit inside their bars).
var TRACK_LANE_PX = 46, TRACK_GAP_PX = 104, DEPTH_PX = FIG_HEIGHT;
function _hexToRgba(hex, alpha) {
  const h = (hex || '').replace('#', '');
  if (h.length !== 6) return hex;
  return 'rgba(' + parseInt(h.slice(0, 2), 16) + ',' + parseInt(h.slice(2, 4), 16) +
         ',' + parseInt(h.slice(4, 6), 16) + ',' + alpha + ')';
}
// Track border/fill for a lane kind, from the server-set body attributes
// (Python is the single source; light/dark picked by theme). Fill is the border
// hue at low alpha so bars read as recessive annotation, not a data series.
function trackColors(kind) {
  const attr = kind === 'gene' ? 'data-track-genes' : 'data-track-primers';
  const pair = (document.body.getAttribute(attr) || '').split(',');
  const line = (isDark() ? pair[1] : pair[0]) || '#5b6b7f';
  return {fill: _hexToRgba(line, isDark() ? 0.34 : 0.24), line: line};
}
// Build the y2 bar traces for one segment's lanes. Genes lane(s) sit on top,
// primer pool lanes below. opts.showGenes / opts.showPrimers (default true)
// filter lanes for the on/off toggles. Returns {traces, nLanes, ticktext}.
function annotationTraces(segLabel, opts) {
  opts = opts || {};
  const model = ANNOT[segLabel || ''];
  if (!model || !model.lanes) return {traces: [], nLanes: 0, ticktext: []};
  const showGenes = opts.showGenes !== false, showPrimers = opts.showPrimers !== false;
  const lanes = model.lanes.filter(function (ln) {
    return ln.kind === 'gene' ? showGenes : showPrimers;
  });
  const n = lanes.length;
  if (!n) return {traces: [], nLanes: 0, ticktext: []};
  const ticktext = [];
  for (let y = 0; y < n; y++) ticktext[y] = lanes[n - 1 - y].label;  // lane 0 = top row
  const traces = lanes.map(function (ln, i) {
    const yIdx = n - 1 - i, feats = ln.features || [], c = trackColors(ln.kind);
    // Genes carry an inside label so need some height; primer bars are pure
    // position markers (height is not meaningful), so draw them thinner.
    const barWidth = ln.kind === 'gene' ? 0.58 : 0.30;
    return {
      type: 'bar', orientation: 'h', yaxis: 'y2', xaxis: 'x',
      // Features are 1-based inclusive [start, end]; draw the bar across the
      // full span (base start-0.5, width end-start+1) so it covers both end
      // bases rather than stopping a position short.
      base: feats.map(function (f) { return f.start - 0.5; }),
      x: feats.map(function (f) { return (f.end - f.start) + 1; }),
      y: feats.map(function () { return yIdx; }),
      width: barWidth,
      marker: {color: c.fill, line: {color: c.line, width: 1}},
      text: ln.kind === 'gene' ? feats.map(function (f) { return f.name; }) : [],
      textposition: 'inside', insidetextanchor: 'middle', cliponaxis: false,
      hovertext: feats.map(function (f) { return f.name + ' (' + f.start + '–' + f.end + ')'; }),
      hoverinfo: 'text', showlegend: false, name: ln.label,
      _track: true, _trackKind: ln.kind
    };
  });
  return {traces: traces, nLanes: n, ticktext: ticktext};
}
// Add the track y-axis (y2) to a depth-chart layout in place, shrinking the
// depth axis domain and growing the figure height so the depth plot keeps its
// size. No-op when there are no lanes.
function withTrackAxes(layout, tm) {
  if (!tm.nLanes) return layout;
  const trackPx = tm.nLanes * TRACK_LANE_PX, total = DEPTH_PX + TRACK_GAP_PX + trackPx;
  layout.height = total;
  layout.yaxis = Object.assign(layout.yaxis || {}, {domain: [(trackPx + TRACK_GAP_PX) / total, 1]});
  layout.yaxis2 = {
    domain: [0, trackPx / total], range: [-0.5, tm.nLanes - 0.5],
    fixedrange: true, zeroline: false, showgrid: false, tickmode: 'array',
    tickvals: tm.ticktext.map(function (_v, i) { return i; }),
    ticktext: tm.ticktext, tickfont: {size: 11}
  };
  return layout;
}

/* ---- shared stats-table renderer (values are pre-formatted server-side) ---- */
function statsTableHTML(rows) {
  if (!rows.length) return '';
  const cols = Object.keys(rows[0]);
  let html = '<table class="stats-table stats-static"><thead><tr>';
  cols.forEach(function (c) { html += '<th>' + c + '</th>'; });
  html += '</tr></thead><tbody>';
  rows.forEach(function (r) {
    html += '<tr>';
    cols.forEach(function (c) { html += '<td>' + r[c] + '</td>'; });
    html += '</tr>';
  });
  return html + '</tbody></table>';
}

/* ---- "By sample" view: one sample, its coverage across segments ---- */
var covScale = 'linear';
var covTracks = {showGenes: true, showPrimers: true};
var currentSample = null;
function plotCoverage(holderId, entries, labelFor, scale, trackOpts) {
  const holder = document.getElementById(holderId);
  if (!holder) return;
  holder.innerHTML = '';
  entries.forEach(function (e, i) {
    const div = document.createElement('div');
    div.id = holderId + '-' + i;
    holder.appendChild(div);
    const lineColor = seriesPalette()[0] || '#2a78d6';
    const trace = {x: e.x, y: depthForScale(e.y, scale), mode: 'lines',
                   line: {width: 2, color: lineColor}, name: labelFor(e), connectgaps: false};
    const tm = annotationTraces(e.label || '', trackOpts);
    const layout = withTrackAxes(coverageLayout(labelFor(e), scale, e.logRange, e.linRange), tm);
    Plotly.newPlot(div, [trace].concat(tm.traces), layout,
                   {responsive: true, displayModeBar: false});
  });
}
function showSample(sample) {
  currentSample = sample;
  const entries = COVERAGE[sample] || [];
  plotCoverage('sample-coverage', entries, function (e) {
    return e.label ? (sample + ' — ' + e.label) : sample;
  }, covScale, covTracks);
  renderSampleStats(sample);
}
function renderSampleStats(sample) {
  const box = document.getElementById('sample-stats');
  if (box) box.innerHTML = statsTableHTML(STATS[sample] || []);
}
// Append a Linear/Log10 scale toggle into a server-rendered controls row.
function injectScaleToggle(controls, onChange) {
  if (controls) controls.appendChild(scaleToggleEl('linear', onChange));
}

/* ---- "By segment" view: one segment, its coverage across every sample ----
   For a segmented genome a Segment selector (server-rendered) picks the segment;
   for an unsegmented genome there is a single whole-genome "segment" with no
   selector, so it stacks every sample's coverage. The <details> structure is
   server-rendered (see the template); the JS below only wires behaviour. */
var segCovScale = 'linear';
var segTracks = {showGenes: true, showPrimers: true};
var currentSegment = null;
// Current segment choice: the selector's value on a segmented run, else '' (the
// single whole-genome view).
function currentSegmentChoice() {
  const sel = document.getElementById('segmentSelect');
  return sel ? sel.value : '';
}
function rowsForSegment(segment) {
  const rows = [];
  Object.keys(STATS).forEach(function (sample) {
    (STATS[sample] || []).forEach(function (r) { if ((r.Segment || '') === segment) rows.push(r); });
  });
  return rows;
}
function showSegment(segment) {
  currentSegment = segment;
  const entries = [];
  Object.keys(COVERAGE).forEach(function (sample) {
    (COVERAGE[sample] || []).forEach(function (e) {
      if ((e.label || '') === segment) entries.push({_sample: sample, x: e.x, y: e.y, logRange: e.logRange, linRange: e.linRange, label: e.label});
    });
  });
  plotCoverage('segment-coverage', entries, function (e) {
    return segment ? (e._sample + ' — ' + segment) : e._sample;
  }, segCovScale, segTracks);
  // The per-segment stats table (one row per sample) is a useful focused subset
  // for a segmented run; for an unsegmented run it would duplicate Assembly
  // statistics, so it is omitted.
  const box = document.getElementById('segment-stats');
  if (box) box.innerHTML = segment ? statsTableHTML(rowsForSegment(segment)) : '';
}
/* ---- aggregated-coverage Linear/Log10 toggle (server-rendered linear first) ----
   Rebuilds every segment panel via Plotly.react on toggle (never a yaxis.type
   relayout). Both axis ranges come from Python (per-panel data attributes), the
   same single source the per-sample charts use — no JS re-derivation. */
function aggregatedLayout(scale, logRange, linMax) {
  const g = depthGuides();
  const linRange = (linMax && linMax > 0) ? [0, linMax] : undefined;
  return {
    autosize: true, height: FIG_HEIGHT, margin: {l: 60, r: 30, t: 24, b: 60},
    paper_bgcolor: 'rgba(0,0,0,0)', plot_bgcolor: 'rgba(0,0,0,0)', font: themeFont(),
    xaxis: {title: {text: 'Genome position'}, gridcolor: 'rgba(137,135,129,0.25)', zeroline: false},
    yaxis: depthYAxis(scale, logRange, linRange),
    hovermode: 'x unified', showlegend: false, shapes: g.shapes, annotations: g.annotations
  };
}
function enhanceAggregatedToggle() {
  if (!window.Plotly) return;
  const card = document.getElementById('aggregated-card');
  if (!card) return;
  const plots = Array.from(card.querySelectorAll('.js-plotly-plot'));
  // Capture each panel's server-rendered depth traces once, so the track traces
  // can be appended fresh on every rebuild without accumulating duplicates.
  plots.forEach(function (gd) { if (!gd._depthData) gd._depthData = (gd.data || []).slice(); });
  const setScale = function (s) {
    aggScale = s;
    plots.forEach(function (gd) {
      const panel = gd.closest('.agg-panel');
      const logRange = panel ? panel.getAttribute('data-log-range').split(',').map(Number) : undefined;
      const linMax = panel ? parseFloat(panel.getAttribute('data-lin-max')) : undefined;
      const seg = panel ? panel.getAttribute('data-key') : '';
      const tm = annotationTraces(seg, aggTrackOpts());
      const layout = withTrackAxes(aggregatedLayout(s, logRange, linMax), tm);
      // Rebuild via react (never a yaxis.type relayout). The depth traces pass
      // through untouched — the y arrays may be Plotly typed-array specs, so we
      // don't remap them; on the log axis Plotly drops the true zeros as gaps,
      // matching the per-sample charts' explicit nulls. Track traces (y2) are
      // appended fresh from the captured depth data.
      try { Plotly.react(gd, gd._depthData.concat(tm.traces), layout, {responsive: true, displayModeBar: false}); } catch (e) {}
    });
  };
  enhanceAggregatedToggle._setScale = setScale;
  const toggle = scaleToggleEl('linear', setScale);
  // Place the toggle after the segment selector when present, else after the heading.
  (card.querySelector('select') || card.querySelector('h2')).insertAdjacentElement('afterend', toggle);
  // Draw the annotation tracks on load (the server render is depth-only), and
  // offer the Genes/Primers on-off chips next to the scale toggle. Skip entirely
  // when no annotation was staged, so a plain run is unchanged.
  if (Object.keys(ANNOT).length) {
    setScale('linear');
    var chips = buildTrackToggles(aggTracks, function () { setScale(aggScale); });
    if (chips) toggle.insertAdjacentElement('afterend', chips);
  }
}
/* ---- annotation-track on/off chips (Genes / Primers) ----
   One chip per track kind that is actually present, default on, styled like the
   scale toggle (aria-pressed). Toggling re-renders the affected view via the
   same Plotly.react/newPlot path the scale toggle uses (never a yaxis.type
   relayout), recomputing lanes so hiding a track reclaims its row. */
var aggTracks = {showGenes: true, showPrimers: true};
var aggScale = 'linear';
function aggTrackOpts() { return aggTracks; }
// Which track kinds exist anywhere in the embedded model.
function annotKinds() {
  var genes = false, primers = false;
  Object.keys(ANNOT).forEach(function (k) {
    (ANNOT[k].lanes || []).forEach(function (ln) {
      if (ln.kind === 'gene') genes = true; else primers = true;
    });
  });
  return {genes: genes, primers: primers};
}
function trackToggleEl(label, initialOn, onChange) {
  var b = document.createElement('button');
  b.type = 'button';
  b.textContent = label;
  b.className = initialOn ? 'active' : '';
  b.setAttribute('aria-pressed', initialOn ? 'true' : 'false');
  b.addEventListener('click', function () {
    var on = b.getAttribute('aria-pressed') !== 'true';
    b.setAttribute('aria-pressed', on ? 'true' : 'false');
    b.classList.toggle('active', on);
    onChange(on);
  });
  return b;
}
// Build the present chips as a .scale-toggle group (or null if no track kind
// exists). `state` is mutated on toggle; `rerender` redraws the view.
function buildTrackToggles(state, rerender) {
  var kinds = annotKinds();
  if (!kinds.genes && !kinds.primers) return null;
  var wrap = document.createElement('div');
  wrap.className = 'scale-toggle track-toggles';
  wrap.setAttribute('role', 'group');
  wrap.setAttribute('aria-label', 'Annotation tracks');
  if (kinds.genes) {
    wrap.appendChild(trackToggleEl('Genes', state.showGenes !== false, function (on) {
      state.showGenes = on; rerender();
    }));
  }
  if (kinds.primers) {
    wrap.appendChild(trackToggleEl('Primers', state.showPrimers !== false, function (on) {
      state.showPrimers = on; rerender();
    }));
  }
  return wrap;
}

/* ---- sequencing-throughput Absolute | Percent toggle ----
   Percent normalises each sample's stacked bar to 100% (fair QC-loss comparison
   across very different depths). Toggled via a cheap layout `barnorm` relayout —
   the freeze-prone slow path is `yaxis.type` on the ~2000-point coverage lines,
   not `barnorm` on a handful of bars, so a relayout is safe here. */
function enhanceThroughputToggle() {
  var card = document.getElementById('throughput-card');
  var group = document.getElementById('throughput-scale');
  if (!card || !group || !window.Plotly) return;
  var gd = card.querySelector('.js-plotly-plot');
  if (!gd) return;
  var apply = function (mode) {
    var percent = mode === 'percent';
    try {
      Plotly.relayout(gd, {
        barnorm: percent ? 'percent' : '',
        'xaxis.title.text': percent ? '% of reads' : 'Reads',
        'xaxis.ticksuffix': percent ? '%' : '',
      });
    } catch (e) { /* not yet drawn */ }
  };
  group.querySelectorAll('button').forEach(function (b) {
    b.addEventListener('click', function () {
      group.querySelectorAll('button').forEach(function (x) {
        x.classList.remove('active');
        x.setAttribute('aria-pressed', 'false');
      });
      b.classList.add('active');
      b.setAttribute('aria-pressed', 'true');
      apply(b.getAttribute('data-mode'));
    });
  });
}

/* ---- KPI tiles: Global | Per-segment switch (segmented runs only) ---- */
var GROUP_KPI = new Intl.NumberFormat('en-US');   // en-US pinned (see number-format gotcha)
// One fixed fractional digit + thousands grouping, matching Python's _fmt_depth
// (f"{v:,.1f}") so the server-rendered and JS-swapped depth tiles agree.
var GROUP_DEPTH = new Intl.NumberFormat('en-US', {minimumFractionDigits: 1, maximumFractionDigits: 1});
function kfmtDepth(v) {
  if (v == null || !isFinite(v)) return '—';
  return GROUP_DEPTH.format(v) + '×';
}
function kfmtPct(v) {  // fraction -> percent, matching Python's _fmt_pct
  if (v == null || !isFinite(v)) return '—';
  return (v * 100).toFixed(1) + '%';
}
function renderKpi(block) {
  var g = document.getElementById('kpi-grid');
  if (!g || !block) return;
  var set = function (key, text) {
    var el = g.querySelector('[data-kpi="' + key + '"]');
    if (el) el.textContent = text;
  };
  var passPct = block.samples ? Math.round(block.pass_count / block.samples * 100) : 0;
  set('samples', GROUP_KPI.format(block.samples));
  set('pass_count', GROUP_KPI.format(block.pass_count));
  set('pass_sub', passPct + '% of run');
  set('below_warn', GROUP_KPI.format(block.below_warn));
  set('median_coverage', kfmtPct(block.median_coverage));
  set('mean_depth', kfmtDepth(block.mean_depth));
  // The warn tile is red only while its count is non-zero (per-segment scope
  // may cross the boundary either way).
  var warnTile = document.getElementById('kpi-warn-tile');
  if (warnTile) warnTile.classList.toggle('kpi-tile-alert', block.below_warn > 0);
}
function initKpiControls() {
  var scope = document.getElementById('kpi-scope');
  if (!scope) return;                       // unsegmented: global tiles only
  var sel = document.getElementById('kpiSegmentSelect');
  var lab = document.getElementById('kpiSegmentLabel');
  var apply = function (mode) {
    var perSeg = mode === 'segment';
    sel.style.display = perSeg ? '' : 'none';
    lab.style.display = perSeg ? '' : 'none';
    renderKpi(perSeg ? (KPI.per_segment[sel.value] || KPI.global) : KPI.global);
  };
  scope.querySelectorAll('button').forEach(function (b) {
    b.addEventListener('click', function () {
      scope.querySelectorAll('button').forEach(function (x) {
        x.classList.remove('active');
        x.setAttribute('aria-pressed', 'false');
      });
      b.classList.add('active');
      b.setAttribute('aria-pressed', 'true');
      apply(b.getAttribute('data-scope'));
    });
  });
  sel.addEventListener('change', function () { renderKpi(KPI.per_segment[sel.value] || KPI.global); });
}

/* ---- run-parameters slide-over drawer ---- */
var _paramsPrevFocus = null;
// Make the rest of the page non-interactive while the modal drawer is open, so
// Tab/AT focus can't wander behind the overlay (aria-modal alone doesn't do this).
function _setBackgroundInert(on) {
  ['header', 'main'].forEach(function (sel) {
    var el = document.querySelector(sel);
    if (!el) return;
    if (on) { el.setAttribute('inert', ''); el.setAttribute('aria-hidden', 'true'); }
    else { el.removeAttribute('inert'); el.removeAttribute('aria-hidden'); }
  });
}
function _drawerFocusables(d) {
  return Array.from(d.querySelectorAll('a[href], button, select, textarea, input, [tabindex]:not([tabindex="-1"])'))
    .filter(function (el) { return !el.disabled && el.offsetParent !== null; });
}
function openParams() {
  var d = document.getElementById('params-drawer'), o = document.getElementById('params-overlay');
  if (!d) return;
  _paramsPrevFocus = document.activeElement;
  o.hidden = false; d.hidden = false;
  _setBackgroundInert(true);
  var btn = document.getElementById('params-btn'); if (btn) btn.setAttribute('aria-expanded', 'true');
  var close = document.getElementById('params-close'); if (close) close.focus();
}
function closeParams() {
  var d = document.getElementById('params-drawer'), o = document.getElementById('params-overlay');
  if (!d || d.hidden) return;
  d.hidden = true; o.hidden = true;
  _setBackgroundInert(false);
  var btn = document.getElementById('params-btn'); if (btn) btn.setAttribute('aria-expanded', 'false');
  if (_paramsPrevFocus && _paramsPrevFocus.focus) _paramsPrevFocus.focus();
}
document.addEventListener('keydown', function (e) {
  var d = document.getElementById('params-drawer');
  var open = d && !d.hidden;
  if (e.key === 'Escape') { closeParams(); return; }
  // Focus trap: keep Tab cycling inside the open drawer.
  if (open && e.key === 'Tab') {
    var f = _drawerFocusables(d);
    if (!f.length) return;
    var first = f[0], last = f[f.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  }
});

/* ---- init ---- */
// Wire a server-rendered <details> detail section: inject its scale toggle and
// render its (heavy) plot lazily the first time the accordion is expanded.
function wireDetailSection(detailsId, controlsOnChange, renderFirst) {
  const details = document.getElementById(detailsId);
  if (!details) return;
  injectScaleToggle(details.querySelector('.chart-controls'), controlsOnChange);
  let rendered = false;
  details.addEventListener('toggle', function () {
    if (details.open && !rendered) { rendered = true; renderFirst(); }
  });
}
window.addEventListener('load', function () {
  // Wire the detail accordions first so opening one always renders its first
  // item inline, independent of the optional chart enhancements below (each of
  // which is isolated so a single failure can't break the rest of the page).
  const sampleSel = document.getElementById('sampleSelect');
  wireDetailSection(
    'by-sample-details',
    function (s) { covScale = s; if (currentSample) showSample(currentSample); },
    function () { if (sampleSel && sampleSel.value) showSample(sampleSel.value); }
  );
  wireDetailSection(
    'by-segment-details',
    function (s) { segCovScale = s; showSegment(currentSegmentChoice()); },
    function () { showSegment(currentSegmentChoice()); }
  );
  // Genes/Primers chips alongside each detail view's scale toggle.
  var sampleChips = buildTrackToggles(covTracks, function () {
    if (currentSample) showSample(currentSample);
  });
  var sampleControls = document.querySelector('#by-sample-details .chart-controls');
  if (sampleChips && sampleControls) sampleControls.appendChild(sampleChips);
  var segChips = buildTrackToggles(segTracks, function () { showSegment(currentSegmentChoice()); });
  var segControls = document.querySelector('#by-segment-details .chart-controls');
  if (segChips && segControls) segControls.appendChild(segChips);

  [themeCharts, initKpiControls, enhanceSortHeaders, initStatsControls,
   enhanceThroughputToggle, enhanceAggregatedToggle].forEach(function (fn) {
    try { fn(); } catch (e) { /* progressive enhancement: never fatal */ }
  });
});
</script>
</body>
</html>
